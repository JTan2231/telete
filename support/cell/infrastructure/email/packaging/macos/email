#!/bin/zsh

unsetopt VERBOSE XTRACE

case "${1-}" in
    --help|-h|--version|-V|--register-usage)
        exec "$HOME/Library/Application Support/Email/install/runtime/libexec/email" "$@"
        ;;
esac

case "${1-}:${2-}:${3-}:${4-}" in
    receive:--help:*|receive:-h:*|receive:--version:*|receive:-V:*|\
    receive:list:--help:*|receive:list:-h:*|receive:get:--help:*|receive:get:-h:*)
        exec "$HOME/Library/Application Support/Email/install/runtime/libexec/email" "$@"
        ;;
esac

usage_thread=${CODEX_THREAD_ID-}
usage_database=${CHANCERY_USAGE_DB-}
usage_disabled=${CHANCERY_USAGE_DISABLED-}
usage_internal=${CHANCERY_USAGE_INTERNAL-}
if [[ -f "${HOME:?}/.zshrc" ]]; then
    source "$HOME/.zshrc" >/dev/null 2>&1
fi
unsetopt VERBOSE XTRACE

exec 3<&0
print -r -- "${RESEND_API_KEY-}" | /usr/bin/env -i \
    HOME="$HOME" \
    CODEX_THREAD_ID="$usage_thread" \
    CHANCERY_USAGE_DB="$usage_database" \
    CHANCERY_USAGE_DISABLED="$usage_disabled" \
    CHANCERY_USAGE_INTERNAL="$usage_internal" \
    PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    /bin/zsh -c '
IFS= read -r RESEND_API_KEY
export RESEND_API_KEY
exec 0<&3
exec 3<&-
exec "$HOME/Library/Application Support/Email/install/runtime/libexec/email" "$@"
' email "$@"
